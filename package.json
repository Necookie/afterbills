{
  "name": "afterbills",
  "private": true,
  "version": "0.0.0",
  "description": "AfterBills — know what’s left after bills and savings are covered.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "core:test": "pnpm --filter @afterbills/core test",
    "db:generate": "pnpm --filter @afterbills/core db:generate",
    "db:push": "pnpm --filter @afterbills/core db:push"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
